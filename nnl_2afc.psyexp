        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="resp, rt, dur = sync_box.get_response(begin_time, timeout=0.001)&amp;#10;if resp:&amp;#10;    key_resp_2.keys = resp&amp;#10;    key_resp_2.rt = rt&amp;#10;    key_resp_2.duration = dur" valType="extendedCode" updates="constant" name="Each Frame"/>
