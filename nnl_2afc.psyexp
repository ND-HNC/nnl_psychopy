      <CodeComponent name="sync_start" plugin="None">
        <Param val="#import nordic_neuro_lab&amp;#10;#&amp;#10;#sync_box = nordic_neuro_lab.SyncBox(&amp;#10;#    num_volumes=300,&amp;#10;#    num_slices=1,&amp;#10;#    trigger_slice=1,&amp;#10;#    trigger_volume=1,&amp;#10;#    pulse_length=100,&amp;#10;#    tr_time=3000,&amp;#10;#    optional_trigger_slice=0,&amp;#10;#    optional_trigger_volume=0,&amp;#10;#    simulation=False,&amp;#10;#)" valType="extendedCode" updates="constant" name="Before Experiment"/>
